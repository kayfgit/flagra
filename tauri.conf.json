{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flagra",
  "version": "0.1.0",
  "identifier": "com.flagra.clipper",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "flagra",
        "width": 980,
        "height": 600,
        "minWidth": 720,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0f0e0c",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=NetworkServiceInProcess2 --disable-gpu --in-process-gpu --disable-background-networking --disable-component-update"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Video",
    "shortDescription": "Instant replay for PCs without a hardware encoder",
    "longDescription": "Press a hotkey to save the last seconds of your screen and desktop audio, ShadowPlay-style, on GPUs without NVENC. Light on CPU and RAM.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer.nsh"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
